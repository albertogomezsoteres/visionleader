(define (problem p-demo)
  (:domain building-indoor)

  (:objects
    robot1 - robot
    ascensor_p0 ascensor_p1 aula_p_1 entrada_p escaleras_p0 escaleras_p1 - ubicacion
    planta_0 planta_1 - planta
  )

  (:init
    (= (total-cost) 0)
    (en robot1 entrada_p)
    (abierto ascensor_p0)
    (abierto ascensor_p1)
    (abierto aula_p_1)
    (abierto entrada_p)
    (abierto escaleras_p0)
    (abierto escaleras_p1)
    (en_planta ascensor_p0 planta_0)
    (en_planta ascensor_p1 planta_1)
    (en_planta aula_p_1 planta_1)
    (en_planta entrada_p planta_0)
    (en_planta escaleras_p0 planta_0)
    (en_planta escaleras_p1 planta_1)
    (es_ascensor ascensor_p0)
    (es_escalera escaleras_p0)
    (es_ascensor ascensor_p1)
    (es_escalera escaleras_p1)
    (conectado_pasillo entrada_p ascensor_p0)
    (= (distancia entrada_p ascensor_p0) 15)
    (conectado_pasillo ascensor_p0 entrada_p)
    (= (distancia ascensor_p0 entrada_p) 15)
    (conectado_pasillo entrada_p escaleras_p0)
    (= (distancia entrada_p escaleras_p0) 15)
    (conectado_pasillo escaleras_p0 entrada_p)
    (= (distancia escaleras_p0 entrada_p) 15)
    (conectado_pasillo ascensor_p0 escaleras_p0)
    (= (distancia ascensor_p0 escaleras_p0) 15)
    (conectado_pasillo escaleras_p0 ascensor_p0)
    (= (distancia escaleras_p0 ascensor_p0) 15)
    (conectado_pasillo aula_p_1 ascensor_p1)
    (= (distancia aula_p_1 ascensor_p1) 15)
    (conectado_pasillo ascensor_p1 aula_p_1)
    (= (distancia ascensor_p1 aula_p_1) 15)
    (conectado_pasillo aula_p_1 escaleras_p1)
    (= (distancia aula_p_1 escaleras_p1) 15)
    (conectado_pasillo escaleras_p1 aula_p_1)
    (= (distancia escaleras_p1 aula_p_1) 15)
    (conectado_pasillo ascensor_p1 escaleras_p1)
    (= (distancia ascensor_p1 escaleras_p1) 15)
    (conectado_pasillo escaleras_p1 ascensor_p1)
    (= (distancia escaleras_p1 ascensor_p1) 15)
    (conectado_ascensor ascensor_p0 ascensor_p1)
    (conectado_ascensor ascensor_p1 ascensor_p0)
    (conectado_escalera_subir escaleras_p0 escaleras_p1)
    (conectado_escalera_bajar escaleras_p1 escaleras_p0)
  )

  (:goal
    (en robot1 aula_p_1)
  )

  (:metric minimize (total-cost))
)
