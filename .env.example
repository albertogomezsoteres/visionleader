# Copy this file to ".env" in the repo root and fill in the values (no quotes).

# Base URL of the tunnel to the Colab vision server (ngrok), no trailing slash.
# If empty, image analysis stays disabled until it is set.
COLAB_API_URL=

# Google Maps Directions API key, used for the outdoor walk between buildings.
GOOGLE_MAPS_API_KEY=

# Optional: path where the backend writes the telemetry log read by the
# end-to-end validation. Leave empty to turn telemetry off.
TELEMETRY_JSONL_PATH=

# The planner runs Fast Downward in Docker (image fast-downward:latest).
# Without Docker, routes that change floor or building cannot be computed.
