# Copia este fichero a ".env" en la raíz del repo y rellena los valores (sin comillas).
# El fichero .env no debe subirse a Git.

# Hugging Face (lectura de modelos gated / descarga de PaliGemma)
HF_TOKEN=

# Google Maps Directions API (rutas exteriores entre edificios)
GOOGLE_MAPS_API_KEY=

# URL base del túnel hacia el notebook Colab (ngrok), sin barra final.
# Opcional: si está vacío, la imagen puede resolverse en local y la transcripción vía Colab quedará deshabilitada hasta configurarla.
COLAB_API_URL=

# Planificación entre plantas/edificios: la API usa Fast Downward en Docker (imagen fast-downward:latest).
# Sin Docker, las rutas que cambian de planta o edificio no podrán calcularse.
